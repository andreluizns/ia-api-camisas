NODE_ENV="development"
PORT=3333
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/NOME_BANCO?schema=public"

GEMINI_API_KEY="[API_KEY]"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_CLASSIFIER_MODEL="gemini-flash-lite-latest"

# Chave exigida no header x-api-key para criar camisas (POST /camisas)
ADMIN_API_KEY="[GERAR_UMA_CHAVE_FORTE_ALEATORIA]"